# BEATMAPPED-UNATTENDED-CITY-WORKER-FOUNDATION-01, reconciled onto the
# modern collector line by BEATMAPPED-UNATTENDED-CITY-WORKER-REAL-
# INTEGRATION-01.
#
# DRAIN-AND-EXIT (BEATMAPPED-CITY-WORKER-DRAIN-AND-EXIT-OPERATOR-LIFECYCLE-01)
#
# systemd unit for the queue-draining city worker
# (ingestion/city-worker/worker-loop-main.mjs, `npm run city-worker:daemon`).
# Sibling to the two existing units this repository already deploys
# (deploy/systemd/botm-unattended.service, a `oneshot` run twice daily by
# botm-unattended.timer for the single-city Lisbon+Porto pipeline;
# deploy/systemd/botm-publication.service, a long-running read-only
# publication endpoint) — this is a THIRD, independent service. It takes
# the single-worker lock, drains every queued city job
# (ingestion/city-worker/queue.mjs) via the
# resolvers/programme-acquisition-resolver.mjs adapter, and then EXITS 0.
#
# It is deliberately NOT always-on. It was, until this package: the worker
# used to idle-poll forever, which left this service `active` indefinitely
# after the first city — and the sanctioned deployment path deliberately
# fails closed while it is active, so every subsequent deployment would
# have been blocked forever. Under drain-and-exit the two policies compose
# on their own: city work running blocks deployment; the queue finishes;
# the worker exits; the service returns to `inactive`; deployment is
# allowed again. See worker-loop.mjs's own header and deploy/README.md,
# "Deploying while a city job is active".
#
# City jobs are enqueued separately, by an operator, via the sanctioned
# "Enqueue BeatMapped City Job" Action (which also issues the idempotent
# `systemctl start` that wakes this unit). This unit never enqueues
# anything itself, and never touches botm-unattended.{service,timer}'s own
# independent schedule.
#
# THIS UNIT IS NEVER ENABLED. `deploy/install.sh` installs and reconciles
# it on every deployment — present, not running, not enabled — and both the
# deployment Action and the operator control fail closed on
# `enabled`/`enabled-runtime`. Acquiring a city is always a deliberate
# operator act, never something a reboot resumes on its own. There is no
# accompanying .timer, and none may be added
# (see deploy/README.md, "City-worker unit ownership").

[Unit]
Description=BeatMapped -- unattended city-job worker (drains the queue, then exits)
Documentation=https://github.com/chriswatson6675/band_on_the_map/blob/main/docs/UNATTENDED_CITY_WORKER.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=botm
Group=botm
WorkingDirectory=/opt/band-on-the-map
# BEATMAPPED_CITY_WORKER_RESOLVER names the module that adapts this
# host's real acquisition interface into the geography-neutral SourceTask
# contract runner.mjs requires -- see ingestion/city-worker/worker-loop-
# main.mjs's own doc comment. The real adapter now exists
# (resolvers/programme-acquisition-resolver.mjs, wired to
# ingestion/programme-acquisition/source-execution.mjs's acquireSource())
# and is bounded-proven against 5 real, already-governed sources -- see
# docs/UNATTENDED_CITY_WORKER.md, "Bounded real-source proof".
Environment=NODE_ENV=production
Environment=BEATMAPPED_CITY_WORKER_RESOLVER=ingestion/city-worker/resolvers/programme-acquisition-resolver.mjs
ExecStart=/usr/bin/node ingestion/city-worker/worker-loop-main.mjs

# Clean shutdown: worker-loop-main.mjs's own SIGTERM/SIGINT handlers ask
# the worker to finish its current batch of in-flight sources and persist
# checkpoints before exiting -- give it real time to do that rather than
# systemd's default 90s, since a single source acquisition can legitimately
# take longer under load.
TimeoutStopSec=120
KillSignal=SIGTERM

# Restart on a genuine crash (an unhandled exception, OOM-kill, etc.) --
# never masks a real process failure the way a bare "always restart
# forever" policy would; RestartSec adds a small floor so a persistently
# crashing worker does not spin the host. Every already-checkpointed
# source and job survives a restart untouched (see
# ingestion/city-worker/checkpoint-store.mjs).
#
# THIS DIRECTIVE IS LEAD-LOAD-BEARING FOR DRAIN-AND-EXIT, and is correct
# for it UNCHANGED. `on-failure` respawns on a non-zero exit, a killing
# signal, a timeout or a watchdog -- and NOT on exit 0. There is
# deliberately NO SuccessExitStatus= here, so "success" means exactly
# exit 0. Against worker-loop-main.mjs's own exit-code contract:
#
#   exit 0  queue drained (or already empty), or a clean SIGTERM shutdown
#           -> NOT respawned. The service goes `inactive` and stays there
#              until the next operator wake. This is the normal end of a
#              city run and is what re-allows deployment.
#   exit 2  ANOTHER_WORKER_RUNNING (lock contention) -> respawned after
#           RestartSec. Deliberate: an operator wake can legitimately land
#           while a previous worker still holds the lock, and retrying
#           until it frees drains the newly-queued job instead of
#           stranding it. RestartSec=10s keeps this well inside systemd's
#           default start-rate limit.
#   exit 1  a genuine fatal error -> respawned, exactly as before.
#
# Do NOT add `Restart=always`, `Restart=on-success`, or
# `SuccessExitStatus=` -- any of the three would respawn a worker that has
# correctly finished, restoring the always-active state that blocked
# deployment in the first place.
Restart=on-failure
RestartSec=10s

# Standard, conservative hardening -- same posture already documented
# (and NOT yet live-verified against the real deployment target) for
# botm-unattended.service; confirm compatibility with this host's actual
# npm/node runtime needs before enabling.
NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=beatmapped-city-worker

[Install]
WantedBy=multi-user.target
