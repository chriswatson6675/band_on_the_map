  {
    "id": 49276,
    "slug": "maim-release-party",
    "title": {
      "rendered": "Maïm release party"
    },
    "acf": {
      "visible_agenda": true,
      "date_display": "vendredi 5 juin",
      "event_date_start": "20260605",
      "event_next_date": null,
      "event_date_end": "20260605",
      "event_description": "MAÏM débarque à Ground Control avec *This Is My Costume*, premier album pop-rock sombre et habité. Une release party frontale, intime, vivante. Le corps parle, les normes grincent.",
      "event_ticket_url": "",
      "event_horaires": "20h-22h",
      "espace_lieu": [
        "Charolais Club"
      ],
      "event_typologie": [
        "concert"
      ],
      "programmation": "Avec This Is My Costume, sorti le 1er mai, MAÏM pose un premier album qui avance à découvert. Une pop-rock sombre et habitée, traversée par des questions très concrètes : l’émancipation, le corps, les normes, les rapports humains. Chez elle, l’intime ne reste pas sagement à sa place. Il déborde, il grince, il prend position.\r\n\r\nInspirée par des imaginaires cinématographiques à la lisière du trouble et du sensible, MAÏM construit des morceaux où la fragilité ne s’excuse pas et où l’intensité ne cherche pas l’effet. Sur scène, ça se traduit par une présence dense, incarnée, sans poudre aux yeux.\r\n\r\nAprès un concert complet aux Disquaires en avril, elle vient à Ground Control le 5 juin pour une release party à la hauteur du disque : habitée, frontale, vivante."
    }
  },
